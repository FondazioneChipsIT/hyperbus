# It fixes the long delays during update_compile_order step
set_param project.hsv.draftModeDefault only

set _xil_proj_name_ "hyperbus"

set origin_dir [exec pwd]

set BOARD [lindex $argv 0]

if {$BOARD eq "vcu118"} {
  set board_part xcvu9p-flga2104-2L-e
} elseif {$BOARD eq "genesys2"} {
  set board_part xc7k325tffg900-2
}

create_project ${_xil_proj_name_} ${origin_dir}/${BOARD} -force -part ${board_part}

# set number of threads to 8 (maximum, unfortunately)
set_param general.maxThreads 8

# Add the Hyperbus constraints
import_files -fileset constrs_1 -norecurse $origin_dir/constraints/hyperbus.xdc

# Add the Hyperbus constraints
import_files -fileset constrs_1 -norecurse $origin_dir/constraints/clock.tcl
set_property USED_IN {implementation} [get_files clock.tcl]

# Add the board constraints
if {$BOARD eq "vcu118"} {
  import_files -fileset constrs_1 -norecurse $origin_dir/constraints/vcu118.xdc
} elseif {$BOARD eq "genesys2"} {
  import_files -fileset constrs_1 -norecurse $origin_dir/constraints/genesys2.xdc
}

# Add the board constraints
if {$BOARD eq "vcu118"} {
  import_files -fileset constrs_1 -norecurse $origin_dir/constraints/floorplan.xdc
  set_property USED_IN {implementation} [get_files floorplan.xdc]
} 

# IPs selection
source ./ips/clk_wiz/clk_wiz_0.tcl
create_clk_wiz $BOARD

source ./ips/jtag_axi_32/jtag_axi_32.tcl
source ./ips/jtag_axi_64/jtag_axi_64.tcl
source ./ips/xlnx_vio/run.tcl


# Add all sources and defines, the add_sources file is automatically generated by Bender.
source $origin_dir/scripts/add_sources.tcl

set_property top ${_xil_proj_name_}_top_xilinx [current_fileset]
update_compile_order -fileset sources_1
set_property XPM_LIBRARIES XPM_MEMORY [current_project]

set_property STEPS.SYNTH_DESIGN.ARGS.RETIMING false [get_runs synth_1]
# Enable sfcu due to package conflicts
set_property -name {STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS} -value {-sfcu} -objects [get_runs synth_1]



#********************* RUN SYNTHESIS ***********************#
launch_runs synth_1 -jobs 12
wait_on_run synth_1
open_run synth_1 -name synth_1

exec mkdir -p reports/
exec rm -rf reports/*

check_timing -verbose                                                   -file reports/${_xil_proj_name_}.check_timing.rpt
report_timing -max_paths 100 -nworst 100 -delay_type max -sort_by slack -file reports/${_xil_proj_name_}.timing_WORST_100.rpt
report_timing -nworst 1 -delay_type max -sort_by group                  -file reports/${_xil_proj_name_}.timing.rpt
report_utilization -hierarchical                                        -file reports/${_xil_proj_name_}.utilization.rpt
report_cdc                                                              -file reports/${_xil_proj_name_}.cdc.rpt
report_clock_interaction                                                -file reports/${_xil_proj_name_}.clock_interaction.rpt


# Instantiate ILA
  set DEBUG [llength [get_nets -hier -filter {MARK_DEBUG == 1}]]
  if ($DEBUG) {
    # Create core
    puts "Creating debug core..."
    create_debug_core u_ila_0 ila
    set_property -dict "ALL_PROBE_SAME_MU true ALL_PROBE_SAME_MU_CNT 4 C_ADV_TRIGGER true C_DATA_DEPTH 16384 \
    C_EN_STRG_QUAL true C_INPUT_PIPE_STAGES 0 C_TRIGIN_EN false C_TRIGOUT_EN false" [get_debug_cores u_ila_0]
    ## Clock
    set_property port_width 1 [get_debug_ports u_ila_0/clk]
    connect_debug_port u_ila_0/clk [get_nets -hier *hype_clk_clk_wiz_0]
    # Get nets to debug
    set debugNets [lsort -dictionary [get_nets -hier -filter {MARK_DEBUG == 1}]]
    set netNameLast ""
    set probe_i 0
    # Loop through all nets (add extra list element to ensure last net is processed)
    foreach net [concat $debugNets {""}] {
      # Remove trailing array index
      regsub {\[[0-9]*\]$} $net {} netName
      # Create probe after all signals with the same name have been collected
      if {$netNameLast != $netName} {
        if {$netNameLast != ""} {
            puts "Creating probe $probe_i with width [llength $sigList] for signal '$netNameLast'"
            # probe0 already exists, and does not need to be created
            if {$probe_i != 0} {
              create_debug_port u_ila_0 probe
            }
            set_property port_width [llength $sigList] [get_debug_ports u_ila_0/probe$probe_i]
            set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports u_ila_0/probe$probe_i]
            connect_debug_port u_ila_0/probe$probe_i [get_nets $sigList]
            incr probe_i
        }
        set sigList ""
      }
      lappend sigList $net
      set netNameLast $netName
    }
    # Need to save save constraints before implementing the core
    # set_property target_constrs_file cheshire.srcs/constrs_1/imports/constraints/$::env(BOARD).xdc [current_fileset -constrset]
    save_constraints -force
    implement_debug_core
    write_debug_probes -force probes.ltx
  }

#********************* RUN IMPLEMENTATION ***********************#

launch_runs impl_1 -jobs 12
wait_on_run impl_1
launch_runs impl_1 -to_step write_bitstream
wait_on_run impl_1

# Check timing constraints
open_run impl_1

set timingrep [report_timing_summary -no_header -no_detailed_paths -return_string]
if {[info exists ::env(XILINX_CHECK_TIMING)] && $::env(XILINX_CHECK_TIMING)==1} {
  if {! [string match -nocase {*timing constraints are met*} $timingrep]} {
    send_msg_id {USER 1-1} ERROR {Timing constraints were not met.}
    return -code error
  }
}

# Output Verilog netlist + SDC for timing simulation
write_verilog -force -mode funcsim out/${_xil_proj_name_}_funcsim.v
write_verilog -force -mode timesim out/${_xil_proj_name_}_timesim.v
write_sdf     -force out/${_xil_proj_name_}_timesim.sdf


#********************* GENERATING REPORTS ***********************#
exec mkdir -p reports/
exec rm -rf reports/*
check_timing                                                              -file reports/${_xil_proj_name_}.check_timing.rpt
report_timing -max_paths 100 -nworst 100 -delay_type max -sort_by slack   -file reports/${_xil_proj_name_}.timing_WORST_100.rpt
report_timing -nworst 1 -delay_type max -sort_by group                    -file reports/${_xil_proj_name_}.timing.rpt
report_utilization -hierarchical                                          -file reports/${_xil_proj_name_}.utilization.rpt
