proc create_clk_wiz {BOARD} {
  
  set clk_wiz_0 [create_ip -name clk_wiz -vendor xilinx.com -library ip -version 6.0 -module_name clk_wiz_0]

  if {$BOARD eq "vcu118"} {

    set_property -dict { 
      CONFIG.PRIMITIVE {Auto}
      CONFIG.PRIM_IN_FREQ {300.000}
      CONFIG.CLKIN1_JITTER_PS {33.330000000000005}
      CONFIG.CLKOUT2_USED {true}
      CONFIG.CLKOUT3_USED {true}
      CONFIG.NUM_OUT_CLKS {3}
      CONFIG.CLK_OUT1_PORT {hype_clk}
      CONFIG.CLK_OUT2_PORT {clk_100}
      CONFIG.CLK_OUT3_PORT {clk_200}
      CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {100.000}
      CONFIG.CLKOUT3_REQUESTED_OUT_FREQ {200.000}
      CONFIG.PRIM_SOURCE {Differential_clock_capable_pin}
      CONFIG.CLKOUT1_DRIVES {Buffer}
      CONFIG.CLKOUT2_DRIVES {Buffer}
      CONFIG.CLKOUT3_DRIVES {Buffer}
      CONFIG.CLKOUT4_DRIVES {Buffer}
      CONFIG.CLKOUT5_DRIVES {Buffer}
      CONFIG.CLKOUT6_DRIVES {Buffer}
      CONFIG.CLKOUT7_DRIVES {Buffer}
      CONFIG.FEEDBACK_SOURCE {FDBK_AUTO}
      CONFIG.USE_LOCKED {false}
      CONFIG.USE_RESET {false}
      CONFIG.MMCM_DIVCLK_DIVIDE {3}
      CONFIG.MMCM_BANDWIDTH {OPTIMIZED}
      CONFIG.MMCM_CLKFBOUT_MULT_F {8}
      CONFIG.MMCM_CLKIN1_PERIOD {3.333}
      CONFIG.MMCM_CLKIN2_PERIOD {10.0}
      CONFIG.MMCM_COMPENSATION {AUTO}
      CONFIG.MMCM_CLKOUT0_DIVIDE_F {8}
      CONFIG.MMCM_CLKOUT1_DIVIDE {8}
      CONFIG.MMCM_CLKOUT2_DIVIDE {4}
      CONFIG.AUTO_PRIMITIVE {PLL}
      CONFIG.CLKOUT1_JITTER {143.207}
      CONFIG.CLKOUT1_PHASE_ERROR {114.212}
      CONFIG.CLKOUT2_JITTER {143.207}
      CONFIG.CLKOUT2_PHASE_ERROR {114.212}
      CONFIG.CLKOUT3_JITTER {125.285}
      CONFIG.CLKOUT3_PHASE_ERROR {114.212}
    } [get_ips clk_wiz_0]

  } elseif {$BOARD eq "genesys2"} {

    set_property -dict { 
      CONFIG.PRIM_IN_FREQ {200.000}
      CONFIG.CLKIN1_JITTER_PS {50.0}
      CONFIG.CLKOUT2_USED {true}
      CONFIG.CLKOUT3_USED {true}
      CONFIG.NUM_OUT_CLKS {3}
      CONFIG.CLK_OUT1_PORT {hype_clk}
      CONFIG.CLK_OUT2_PORT {clk_100}
      CONFIG.CLK_OUT3_PORT {clk_200}
      CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {100.000}
      CONFIG.CLKOUT3_REQUESTED_OUT_FREQ {200.000}
      CONFIG.PRIM_SOURCE {Differential_clock_capable_pin}
      CONFIG.CLKOUT1_DRIVES {BUFG}
      CONFIG.CLKOUT2_DRIVES {BUFG}
      CONFIG.CLKOUT3_DRIVES {BUFG}
      CONFIG.FEEDBACK_SOURCE {FDBK_AUTO}
      CONFIG.USE_LOCKED {false}
      CONFIG.MMCM_DIVCLK_DIVIDE {1}
      CONFIG.MMCM_CLKFBOUT_MULT_F {5.000}
      CONFIG.MMCM_CLKIN1_PERIOD {5.000}
      CONFIG.MMCM_CLKIN2_PERIOD {10.0}
      CONFIG.MMCM_COMPENSATION {ZHOLD}
      CONFIG.MMCM_CLKOUT0_DIVIDE_F {10.000}
      CONFIG.MMCM_CLKOUT1_DIVIDE {10}
      CONFIG.MMCM_CLKOUT2_DIVIDE {5}
      CONFIG.CLKOUT1_JITTER {112.316}
      CONFIG.CLKOUT1_PHASE_ERROR {89.971}
      CONFIG.CLKOUT2_JITTER {112.316}
      CONFIG.CLKOUT2_PHASE_ERROR {89.971}
      CONFIG.CLKOUT3_JITTER {98.146}
      CONFIG.CLKOUT3_PHASE_ERROR {89.971}
    } [get_ips clk_wiz_0]

  } else {

    puts "Board not available"

  }
}

